---
import Base from '../../../layouts/Base.astro';
import AlertasCta from '../../../components/AlertasCta.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { SITE } from '../../../lib/config';
import { getJuego, getSorteosByJuego, formatMoney } from '../../../lib/data';

export function getStaticPaths() {
  const paths = [];
  for (const slug of ['melate', 'melate-revancha', 'melate-revanchita', 'melate-retro', 'chispazo', 'chispazo-de-las-tres', 'tris', 'gana-gato']) {
    for (const s of getSorteosByJuego(slug)) {
      paths.push({ params: { juego: slug, numero: String(s.numero) } });
    }
  }
  return paths;
}

const { juego, numero } = Astro.params;
const j = getJuego(juego!);
const s = getSorteosByJuego(juego!).find((x) => x.numero === Number(numero));
if (!j || !s) return Astro.redirect('/404/');
---
<Base title={`Sorteo ${s.numero} ${j.nombre}`}
  jsonLd={[
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE + '/' },
      { '@type': 'ListItem', position: 2, name: j.nombre, item: `${SITE}/${juego}/` },
      { '@type': 'ListItem', position: 3, name: `Sorteo ${s.numero}`, item: `${SITE}/${juego}/sorteo-${s.numero}/` },
    ] },
    { '@type': 'Event', name: `Sorteo ${s.numero} de ${j.nombre}`, startDate: s.fecha, eventStatus: 'https://schema.org/EventScheduled', eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode', location: { '@type': 'VirtualLocation', url: 'https://www.loterianacional.gob.mx/' }, organizer: { '@type': 'Organization', name: 'Lotería Nacional', url: 'https://www.loterianacional.gob.mx/' }, description: `Combinación ganadora: ${s.numeros.join(' ')}${s.adicional !== undefined ? ` adicional ${s.adicional}` : ''}.` },
  ]}
  description={`Resultado del sorteo ${s.numero} de ${j.nombre} del ${s.fecha}: ${s.numeros.join(', ')}${s.adicional !== undefined ? ` + ${s.adicional}` : ''}.`}
>
  <p class="crumb"><a href="/">Inicio</a> / <a href={`/${juego}/`}>{j.nombre}</a> / Sorteo {s.numero}</p>
  <h1>Sorteo {s.numero} · {s.fecha}{s.hora ? ` · ${s.hora}` : ''}</h1>
  {s.nombre && <p class="nombre">{s.nombre}</p>}
  <div class={`panel`}><div class={`numeros g-${juego}`}>
    {s.numeros.map((n) => <span class="bola lg">{n.toString().padStart(2, '0')}</span>)}
    {s.adicional !== undefined && <span class="bola extra">{s.adicional.toString().padStart(2, '0')} <small>adic.</small></span>}
  </div>
  </div>
  {s.bolsa_mxn && <p class="bolsa">Bolsa acumulada: {formatMoney(s.bolsa_mxn)}</p>}
  <dl class="info">
    <div><dt>Formato</dt><dd>{j.formato}</dd></div>
    <div><dt>Probabilidad mayor</dt><dd>{j.probabilidad_mayor}</dd></div>
    <div><dt>Premio mínimo</dt><dd>{formatMoney(j.premio_minimo_mxn)}</dd></div>
  </dl>
  <p><a href="/verificador/">Verifica tu boleto</a></p>
  <AlertasCta />
  <AdSlot slot={import.meta.env.PUBLIC_ADS_SLOT_SORTEO} />
  <p class="aviso">Verifica tu boleto en el sitio oficial de {j.operador}. Los premios se cobran con el boleto físico.</p>
  <p class="disc-legal">Información con fines informativos; puede contener errores. La fuente oficial prevalece y las estadísticas no predicen resultados. Verifica siempre con tu boleto oficial. Solo mayores de 18 años. <a href="/aviso-legal/">Aviso legal</a>.</p>
</Base>
<style>
  .crumb a { color: var(--muted); text-decoration: none; font-size: 0.9rem; }
  h1 { margin: 0.5rem 0; }
  .nombre { color: var(--muted); margin-bottom: 1rem; }
  .numeros { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0; }
  .bolsa { color: var(--accent); font-weight: 700; font-size: 1.2rem; margin-bottom: 1.5rem; }
  .info { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem; }
  .info div { background: var(--card); border-radius: 8px; padding: 0.75rem; }
  .info dt { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; }
  .info dd { font-weight: 600; }
  .aviso { color: var(--muted); font-size: 0.85rem; }

  .panel { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; margin: 1rem 0; box-shadow: var(--shadow); }
  .panel .numeros { margin: 0; gap: .6rem; }
  .bolsa { color: var(--brand); }
  .info div { border: 1px solid var(--line); }
</style>
