---
import Base from '../../layouts/Base.astro';
import Verificador from '../../components/Verificador.astro';
import AlertasCta from '../../components/AlertasCta.astro';
import AdSlot from '../../components/AdSlot.astro';
import { SITE } from '../../lib/config';
import { getJuego, getSorteosByJuego, formatMoney } from '../../lib/data';

export function getStaticPaths() {
  return ['melate', 'melate-revancha', 'melate-revanchita', 'melate-retro', 'chispazo', 'chispazo-de-las-tres', 'tris', 'gana-gato'].map((juego) => ({ params: { juego } }));
}

const { juego } = Astro.params;
const j = getJuego(juego!);
if (!j) return Astro.redirect('/404/');
const lista = getSorteosByJuego(juego!);
---
<Base title={j.nombre} description={j.descripcion} jsonLd={[{ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE + '/' }, { '@type': 'ListItem', position: 2, name: j.nombre, item: `${SITE}/${juego}/` }] }, { '@type': 'Dataset', name: `Resultados históricos de ${j.nombre}`, description: `Números ganadores de ${j.nombre} publicados por Lotería Nacional.`, url: `${SITE}/${juego}/`, isBasedOn: 'https://www.loterianacional.gob.mx/DatosAbiertos/NumerosGanadores', inLanguage: 'es-MX', temporalCoverage: `${lista[lista.length - 1]?.fecha}/${lista[0]?.fecha}` }]}>
  <p class="crumb"><a href="/">Inicio</a> / {j.nombre}</p>
  <h1>Resultados {j.nombre}</h1>
  <p class="desc">{j.descripcion}</p>
  <dl class="info">
    <div><dt>Operador</dt><dd>{j.operador}</dd></div>
    <div><dt>Formato</dt><dd>{j.formato}</dd></div>
    <div><dt>Probabilidad mayor</dt><dd>{j.probabilidad_mayor}</dd></div>
    <div><dt>Premio mínimo</dt><dd>{formatMoney(j.premio_minimo_mxn)}</dd></div>
    <div><dt>Días</dt><dd>{j.dias.join(', ')}</dd></div>
    <div><dt>Hora</dt><dd>{j.hora}</dd></div>
    <div><dt>Precio boleto</dt><dd>{j.precio_boleto_mxn} MXN</dd></div>
  </dl>
  <div class="links">
    <a href="resultados">Resultados</a>
    <a href="estadisticas">Estadísticas</a>
  </div>
  <Verificador juego={juego} />
  <AlertasCta />
  <AdSlot slot={import.meta.env.PUBLIC_ADS_SLOT_HUB} />
  <h2>Últimos sorteos</h2>
  <ul class="lista">
    {lista.slice(0, 10).map((s) => (
      <li>
        <a href={`sorteo-${s.numero}/`}>
          Sorteo {s.numero} · {s.fecha}{s.hora ? ` · ${s.hora}` : ''}
        </a>
        <span class={`nums numeros g-${juego}`}>{s.numeros.map((n) => <span class="bola sm">{n}</span>)}{s.adicional !== undefined && <span class="bola sm extra">{s.adicional}</span>}</span>
        {s.bolsa_mxn && <span class="bolsa">{formatMoney(s.bolsa_mxn)}</span>}
      </li>
    ))}
  </ul>
</Base>
<style>
  h1 { margin-bottom: 0.25rem; }
  .desc { color: var(--muted); margin-bottom: 1.5rem; }
  .info { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem; }
  .info div { background: var(--card); border-radius: 8px; padding: 0.75rem; }
  .info dt { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; }
  .info dd { font-weight: 600; }
  .links { display: flex; gap: 1rem; margin-bottom: 2rem; }
  .links a { color: var(--accent); }
  .lista { list-style: none; }
  .lista li { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; padding: 0.6rem 0; border-bottom: 1px solid var(--line); }
  .lista a { color: var(--text); text-decoration: none; font-weight: 600; }
  .lista a:hover { color: var(--accent); }
  .nums { color: var(--muted); font-size: 0.9rem; }
  .bolsa { color: var(--accent); font-weight: 600; margin-left: auto; }

  .info { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .6rem; margin: 1rem 0; }
  .info div { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: .6rem .75rem; }
  .info dt { color: var(--muted); font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; }
  .info dd { font-weight: 700; }
  .links { display: flex; gap: .5rem; flex-wrap: wrap; }
  .links a { background: var(--card); border: 1px solid var(--line); border-radius: 999px; padding: .35rem .9rem; font-weight: 600; text-decoration: none; }
  .lista { list-style: none; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 0 1rem; }
  .lista li:last-child { border-bottom: 0; }
  .lista a { font-weight: 600; min-width: 13rem; }
</style>
