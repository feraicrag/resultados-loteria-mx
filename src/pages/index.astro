---
import Base from '../layouts/Base.astro';
import { juegos, getUltimoSorteo, formatMoney } from '../lib/data';
---
<Base title="Resultados de hoy">
  <h1>Resultados de Lotería de México</h1>
  <p class="lead">Números ganadores de Melate, Chispazo, Tris y Gana Gato. Actualizado tras cada sorteo.</p>
  <div class="grid">
    {juegos.map((j) => {
      const ultimo = getUltimoSorteo(j.slug);
      return (
        <a href={`/${j.slug}/`} class="card">
          <h2>{j.nombre}</h2>
          <p class="meta">{j.operador} · {j.formato} · {j.precio_boleto_mxn} MXN</p>
          {ultimo && (
            <>
              <p class="fecha">Sorteo {ultimo.numero} · {ultimo.fecha}{ultimo.hora ? ` · ${ultimo.hora}` : ''}</p>
              <div class="numeros">
                {ultimo.numeros.map((n) => <span class="bola">{n.toString().padStart(2, '0)}</span>)}
                {ultimo.adicional !== undefined && <span class="bola extra">{ultimo.adicional.toString().padStart(2, '0')} <small>adic.</small></span>}
              </div>
              {ultimo.bolsa_mxn && <p class="bolsa">Bolsa: {formatMoney(ultimo.bolsa_mxn)}</p>}
            </>
          )}
        </a>
      );
    })}
  </div>
</Base>
<style>
  h1 { font-size: 1.8rem; margin-bottom: 0.5rem; }
  .lead { color: var(--muted); margin-bottom: 2rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
  .card {
    background: var(--card);
    border-radius: 12px;
    padding: 1.25rem;
    text-decoration: none;
    color: inherit;
    border: 1px solid #334155;
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .card h2 { font-size: 1.15rem; margin-bottom: 0.25rem; }
  .meta { color: var(--muted); font-size: 0.85rem; margin-bottom: 0.75rem; }
  .fecha { font-size: 0.85rem; color: var(--muted); margin-bottom: 0.5rem; }
  .numeros { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.5rem; }
  .bola {
    background: var(--accent);
    color: #0f172a;
    font-weight: 700;
    border-radius: 50%;
    width: 2rem; height: 2rem;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 0.85rem;
  }
  .bola.extra { background: #64748b; color: var(--text); border-radius: 999px; width: auto; padding: 0 0.6rem; }
  .bola small { font-weight: 400; font-size: 0.65rem; }
  .bolsa { color: var(--accent); font-weight: 600; font-size: 0.9rem; }
</style>
