---
import Base from '../layouts/Base.astro';
import Verificador from '../components/Verificador.astro';
import AlertasCta from '../components/AlertasCta.astro';
---
<Base title="Verifica tu boleto" description="Compara tu boleto de Melate, Revancha, Revanchita, Retro, Chispazo, Tris o Gana Gato con los resultados oficiales recientes.">
  <h1>Verifica tu boleto</h1>
  <p>Elige el juego, escribe tus números y, si quieres, el número de sorteo. Si lo dejas vacío usamos el sorteo más reciente.</p>
  <Verificador />
  <AlertasCta />
  <p class="disc-legal">Información con fines informativos; puede contener errores. La fuente oficial prevalece y las estadísticas no predicen resultados. Verifica siempre con tu boleto oficial. Solo mayores de 18 años. <a href="/aviso-legal/">Aviso legal</a>.</p>
</Base>
