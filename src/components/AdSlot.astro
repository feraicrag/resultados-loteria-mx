---
// Espacio de anuncio preparado. No renderiza nada mientras no haya PUBLIC_ADS_CLIENT y slot.
import { ADS_CLIENT } from '../lib/config';
interface Props { slot?: string }
const { slot = '' } = Astro.props;
---
{ADS_CLIENT && slot && (
  <div class="ad">
    <ins class="adsbygoogle" style="display:block" data-ad-client={ADS_CLIENT} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
  </div>
)}
