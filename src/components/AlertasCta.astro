---
import { ALERTAS_URL } from '../lib/config';
---
{ALERTAS_URL && (
  <aside class="alertas">
    <strong>Recibe los resultados al momento</strong>
    <p>Te avisamos en cuanto salen los números ganadores.</p>
    <a href={ALERTAS_URL} rel="noopener" target="_blank">Suscribirme gratis</a>
  </aside>
)}
<style>
  .alertas { background: var(--card); border: 1px solid var(--accent); border-radius: 8px; padding: 1rem; margin: 1.5rem 0; }
  .alertas a { display: inline-block; margin-top: 0.5rem; background: var(--accent); color: #0f172a; padding: 0.4rem 0.9rem; border-radius: 6px; font-weight: 700; text-decoration: none; }
</style>
